<Window x:Class="Jiaolong.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TDPC · 蛟龙独立控制台"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1140" Height="820" MinWidth="1000" MinHeight="660"
        Background="{DynamicResource BackdropBrush}" WindowStyle="None"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, -apple-system, 'Microsoft YaHei'" FontSize="13"
        Foreground="{DynamicResource TitleText}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                             GlassFrameThickness="1" CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- liquid glass card: gradient volume + specular edge + soft ambient shadow -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        </Style>

        <!-- one level of depth below a card: gauge bays, sensor chips, control groups -->
        <Style x:Key="SubPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TitleText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- every readout uses a monospaced face so digits align in columns (instrument look) -->
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NumText}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnFace}" />
            <Setter Property="Foreground" Value="{DynamicResource ValueText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnFaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- caption (window) button -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource RowText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- glow button: the one primary action inside a card -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBg}" />
            <Setter Property="Effect" Value="{DynamicResource GlowShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS/macOS-style switch: lit track, floating thumb -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" CornerRadius="11.5"
                                Background="{DynamicResource TrackOff}"
                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="17" Height="17"
                                     Fill="{DynamicResource Thumb}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270"
                                                      Color="#000000" Opacity="0.30" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryBtnBg}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- liquid slider: lit thumb riding a soft recessed track -->
        <Style x:Key="LiquidSlider" TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Margin="0,5">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackOff}" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="17" Height="17"
                                                         Fill="{DynamicResource Thumb}"
                                                         Stroke="{DynamicResource Accent}" StrokeThickness="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RowText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ValueText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- esports quick palette chip button -->
        <Style x:Key="PaletteChip" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="24" Height="24" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                  Color="#000000" Opacity="0.35" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Context Menu -->
        <ContextMenu x:Key="TrayContextMenu" Background="{DynamicResource CardBg}"
                     BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource ValueText}" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="{DynamicResource PanelBorder}" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="4,3" />
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="🖥  显示主控制台" FontWeight="Bold" Click="TrayShow_Click" />
            <Separator />
            <MenuItem Header="⚡  狂飙模式 (5000 RPM)" Click="TrayModeBurst_Click" />
            <MenuItem Header="🎮  游戏模式 (5000 RPM)" Click="TrayModeGame_Click" />
            <MenuItem Header="🍃  办公模式 (2700 RPM)" Click="TrayModeQuiet_Click" />
            <Separator />
            <MenuItem Header="🌀  交还 BIOS 托管风扇" Click="TrayReleaseFan_Click" />
            <Separator />
            <MenuItem Header="✕  退出 TDPC" Foreground="{DynamicResource Danger}" Click="TrayExit_Click" />
        </ContextMenu>
        <!-- modern sleek liquid-glass scrollbar -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd"
                                Background="{DynamicResource ScrollThumb}"
                                CornerRadius="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource ScrollThumbActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Stretch">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" VerticalAlignment="Stretch">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Backdrop brush -->
        <Border x:Name="Backdrop" Opacity="1" Background="{DynamicResource BackdropBrush}" />

        <!-- Ambient Liquid Glow Orbs (Cached in GPU bitmap cache to prevent redraw lag) -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Canvas.CacheMode>
                <BitmapCache RenderAtScale="1" SnapsToDevicePixels="True" />
            </Canvas.CacheMode>
            <Ellipse Canvas.Left="30" Canvas.Top="-50" Width="400" Height="400" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00F0FF" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.8" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="620" Canvas.Top="320" Width="450" Height="450" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9D4EDD" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.8" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid x:Name="RootContainer" Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER / TITLEBAR ================= -->
            <DockPanel Grid.Row="0" Background="Transparent"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" LastChildFill="False">
                <!-- Left Title & Logo -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,12,0" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#00F0FF" Opacity="0.45" ShadowDepth="0" />
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/app.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TitleText}"
                               FontSize="14.5" FontWeight="Bold" Text="TDPC · 蛟龙独立控制台" />

                    <Border Margin="10,0,0,0" Background="{DynamicResource PillBg}" CornerRadius="10"
                            Padding="8,2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="2023 PRO" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtitleText}" />
                    </Border>

                    <!-- Status Pill -->
                    <Border Margin="10,0,0,0" Background="{DynamicResource PillBg}" CornerRadius="11"
                            Padding="10,4" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="OwnerPill" Text="启动中…" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warn}" FontSize="11.5" />
                    </Border>
                </StackPanel>

                <!-- Right Caption Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button x:Name="BtnTheme" Style="{StaticResource CaptionBtn}" Click="BtnTheme_Click" ToolTip="切换浅色 / 深色">
                        <TextBlock x:Name="ThemeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE708;" />
                    </Button>
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Click="BtnMin_Click" ToolTip="最小化">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Click="BtnMax_Click" ToolTip="最大化">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionClose}" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ================= SUBTITLE ================= -->
            <TextBlock Grid.Row="1" Margin="22,0,0,12" Foreground="{DynamicResource SubtitleText}"
                       FontSize="11.5"
                       Text="Jiaolong 16PRO 2023 · Ryzen 7 7745HX + RTX 4070 · 硬件直连 · 独立于官方控制台 · 无第三方依赖" />

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN ================= -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,4,8,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- CARD 1: FAN TURBINE CONTROLLER -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#1800F0FF" Margin="0,0,8,0">
                                            <TextBlock Text="🌀" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="双涡轮温控与风扇" Style="{StaticResource CardTitle}" />
                                    </StackPanel>

                                    <!-- Core Temp Badge -->
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBg}"
                                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="CPU 核心" Style="{StaticResource Label}" FontSize="11.5" Margin="0,0,7,0" />
                                            <TextBlock x:Name="TempText" Text="--" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
                                            <TextBlock Text="℃" Style="{StaticResource Label}" FontSize="11.5" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <!-- Two Turbine Bays (CPU / GPU) -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SubPanel}">
                                        <StackPanel>
                                            <TextBlock Text="CPU 涡轮风扇" Style="{StaticResource Label}" HorizontalAlignment="Center" FontSize="11.5" />
                                            <TextBlock x:Name="FanCpu" Text="--" Style="{StaticResource Big}" Margin="0,4,0,2" />
                                            <TextBlock Text="RPM" Style="{StaticResource Label}" HorizontalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SubPanel}">
                                        <StackPanel>
                                            <TextBlock Text="GPU 涡轮风扇" Style="{StaticResource Label}" HorizontalAlignment="Center" FontSize="11.5" />
                                            <TextBlock x:Name="FanGpu" Text="--" Style="{StaticResource Big}"
                                                       Foreground="{DynamicResource NeonBlue}" Margin="0,4,0,2" />
                                            <TextBlock Text="RPM" Style="{StaticResource Label}" HorizontalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Slider Bay -->
                                <Border Style="{StaticResource SubPanel}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="目标锁定转速 (Target RPM)" Style="{StaticResource Label}" DockPanel.Dock="Left" FontSize="11.5" />
                                            <TextBlock x:Name="FanTarget" Text="2100 RPM" Style="{StaticResource Value}"
                                                       DockPanel.Dock="Right" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" />
                                        </DockPanel>
                                        <Slider x:Name="FanSlider" Style="{StaticResource LiquidSlider}"
                                                Minimum="1800" Maximum="5800" Value="2100"
                                                SmallChange="100" LargeChange="500" TickFrequency="100"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="FanSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Upper bound & Safety valve row -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- upper bound (WMI 0x15) -->
                                    <Border Grid.Column="0" Style="{StaticResource SubPanel}" Padding="10,6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="风扇转速上限" FontSize="11" Style="{StaticResource Label}" />
                                                <TextBlock Text="按模式保存 · 0跟随默认" FontSize="9.5" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBox x:Name="FanUpperBox" Style="{StaticResource NumBox}" Width="66"
                                                         TextAlignment="Right" Text="5000"
                                                         LostFocus="FanUpper_Committed" KeyDown="FanUpper_KeyDown" />
                                                <TextBlock Text="RPM" Style="{StaticResource Label}" Margin="6,0,0,0" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Safety threshold -->
                                    <Border Grid.Column="2" Style="{StaticResource SubPanel}" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="安全阀" Style="{StaticResource Label}" Margin="0,0,7,0" FontSize="11" />
                                            <TextBox x:Name="SafetyBox" Style="{StaticResource NumBox}" Width="44" Text="92" TextAlignment="Center" />
                                            <TextBlock Text="℃" Style="{StaticResource Label}" Margin="6,0,0,0" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Action Buttons -->
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="BtnFanLock" Content="锁定转速" Style="{StaticResource PrimaryBtn}" Click="BtnFanLock_Click" />
                                        <Button x:Name="BtnFanRelease" Content="交还 BIOS" Style="{StaticResource Btn}" Click="BtnFanRelease_Click" Margin="8,0,0,0" />
                                        <Button x:Name="BtnCurve" Style="{StaticResource Btn}" Click="BtnCurve_Click" Margin="8,0,0,0"
                                                Content="温度曲线" ToolTip="按温度插值驱动转速（每秒写入 EC）" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock x:Name="FanNote" Text="" Style="{StaticResource Label}"
                                           Margin="2,10,0,0" FontSize="11" Foreground="{DynamicResource SubtitleText}" />
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: CPU 7745HX TUNING & POWER -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#18FF7A00" Margin="0,0,8,0">
                                            <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="AMD 锐龙 7745HX 极客温控与功耗" Style="{StaticResource CardTitle}" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillBg}" CornerRadius="8"
                                            Padding="7,2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                        <TextBlock Text="Zen 4 · 8C/16T" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NeonCyan}" />
                                    </Border>
                                </DockPanel>

                                <!-- Control Rows Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <!-- 0: Max Frequency -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="限制频率" Style="{StaticResource Row}" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0">
                                        <TextBox x:Name="FreqBox" Style="{StaticResource NumBox}" Width="78" TextAlignment="Right" Text="4200" LostFocus="FreqBox_Committed" KeyDown="FreqBox_KeyDown" />
                                        <TextBlock Text="MHz" Style="{StaticResource Label}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="FreqSwitch" Grid.Row="0" Grid.Column="2" Style="{StaticResource Switch}" Checked="FreqSwitch_Changed" Unchecked="FreqSwitch_Changed" />

                                    <!-- 1: Turbo Boost -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="关闭睿频" Style="{StaticResource Row}" />
                                    <ToggleButton x:Name="TurboSwitch" Grid.Row="1" Grid.Column="2" Style="{StaticResource Switch}" Checked="TurboSwitch_Changed" Unchecked="TurboSwitch_Changed" />

                                    <!-- 2: Temp Wall -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU 目标温度墙" Style="{StaticResource Row}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0">
                                        <TextBox x:Name="TempWallBox" Style="{StaticResource NumBox}" Width="78" TextAlignment="Right" Text="99" LostFocus="TempWall_Committed" KeyDown="TempWall_KeyDown" />
                                        <TextBlock Text="℃" Style="{StaticResource Label}" Margin="7,0,0,0" />
                                    </StackPanel>

                                    <!-- 3: SPL (WMI 0x17) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="长时功耗 SPL" Style="{StaticResource Row}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0">
                                        <TextBox x:Name="SplBox" Style="{StaticResource NumBox}" Width="78" TextAlignment="Right" Text="82" LostFocus="Spl_Committed" KeyDown="Spl_KeyDown" />
                                        <TextBlock Text="W" Style="{StaticResource Label}" Margin="7,0,0,0" />
                                    </StackPanel>

                                    <!-- 4: SPPT (WMI 0x17) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="短时功耗 SPPT" Style="{StaticResource Row}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0">
                                        <TextBox x:Name="SpptBox" Style="{StaticResource NumBox}" Width="78" TextAlignment="Right" Text="105" LostFocus="Sppt_Committed" KeyDown="Sppt_KeyDown" />
                                        <TextBlock Text="W" Style="{StaticResource Label}" Margin="7,0,0,0" />
                                    </StackPanel>

                                    <!-- 5: Curve Optimizer (SMU -50..0) -->
                                    <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="电压调节 CO (AMD 降压)" Style="{StaticResource Row}" />
                                        <TextBlock Text="-50..0 mV · 降温降压" FontSize="10" Foreground="{DynamicResource SubtitleText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBox x:Name="CoBox" Style="{StaticResource NumBox}" Width="78" TextAlignment="Right" Text="-40"
                                                 LostFocus="Co_Committed" KeyDown="Co_KeyDown" />
                                        <TextBlock Text="mV" Style="{StaticResource Label}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="CoSwitch" Grid.Row="5" Grid.Column="2" Style="{StaticResource Switch}"
                                                  Checked="Co_Changed" Unchecked="Co_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: 16 PANORAMIC TELEMETRY SENSORS -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#1800E676" Margin="0,0,8,0">
                                            <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="硬件高精遥测传感器" Style="{StaticResource CardTitle}" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="刷新" Style="{StaticResource Label}" FontSize="11" Margin="0,0,6,0" />
                                        <TextBox x:Name="IntervalBox" Style="{StaticResource NumBox}" Width="42" TextAlignment="Center" Text="1"
                                                 LostFocus="Interval_Committed" KeyDown="Interval_KeyDown" Padding="4,2" FontSize="11.5" />
                                        <TextBlock Text="秒" Style="{StaticResource Label}" FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- 16 Micro Sensors Grid (4x4 Matrix) -->
                                <UniformGrid Columns="4" Rows="4">
                                    <!-- Row 1: CPU 频率, CPU 占用, GPU 温度, GPU 频率 -->
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="CPU 频率" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CpuFreq" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonCyan}" FontSize="14" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="CPU 占用" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CpuLoad" Text="--" Style="{StaticResource Value}" FontSize="14" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="GPU 温度" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="GpuTemp" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonAmber}" FontSize="14" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="GPU 频率" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="GpuClock" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonBlue}" FontSize="14" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 2: 核心数, CPU 基频, GPU 占用, GPU 功耗 -->
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="核心规格" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CpuCores" Text="--" Style="{StaticResource Value}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="CPU 基频" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CpuMax" Text="--" Style="{StaticResource Value}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="GPU 占用" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="GpuLoad" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonBlue}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="GPU 功耗" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="GpuPower" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonAmber}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 3: 内存占用, 可用内存, 系统盘可用, 系统盘占用 -->
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="内存占用" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="MemLoad" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonPurple}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="可用内存" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="MemAvail" Text="--" Style="{StaticResource Value}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="系统盘可用" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="DiskAvail" Text="--" Style="{StaticResource Value}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="系统盘占用" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="DiskLoad" Text="--" Style="{StaticResource Value}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 4: CPU 功耗, 电压调节 CO, SMU 确认, 睿频状态 -->
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="CPU 功耗" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CpuPower" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonCyan}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="电压调节 CO" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CoSetting" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonEmerald}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="SMU 确认" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="CoAck" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonEmerald}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubPanel}" Margin="2" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="睿频状态" Style="{StaticResource Label}" FontSize="10" />
                                            <TextBlock x:Name="TurboState" Text="--" Style="{StaticResource Value}" Foreground="{DynamicResource NeonBlue}" FontSize="13" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ================= RIGHT COLUMN ================= -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,4,8,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- CARD 1: PERFORMANCE PROFILES -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#18388BFD" Margin="0,0,8,0">
                                            <TextBlock Text="🔥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="性能调度模式" />
                                    </StackPanel>
                                    <TextBlock x:Name="ModeNote" Text="" Style="{StaticResource Label}" DockPanel.Dock="Right"
                                               FontSize="11" Foreground="{DynamicResource SubtitleText}" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 3-Segment Glider Container -->
                                <Border Background="{DynamicResource SegBg}" CornerRadius="12" Padding="3"
                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                    <UniformGrid Columns="3">
                                        <Button x:Name="ModeBurst" Content="狂飙" Style="{StaticResource Btn}" Click="Mode_Click" Tag="1" Height="34" Margin="1" />
                                        <Button x:Name="ModeGame" Content="游戏" Style="{StaticResource Btn}" Click="Mode_Click" Tag="0" Height="34" Margin="1" />
                                        <Button x:Name="ModeQuiet" Content="办公" Style="{StaticResource Btn}" Click="Mode_Click" Tag="2" Height="34" Margin="1" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: RGB LIGHTING & BACKLIGHT CONTROLLER -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#189D4EDD" Margin="0,0,8,0">
                                            <TextBlock Text="💡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="灯光系统与键盘背光" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource PillBg}" CornerRadius="6"
                                            Padding="6,2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                        <TextBlock Text="全彩 RGB 矩阵" FontSize="9.5" FontFamily="Segoe UI" Foreground="{DynamicResource NeonCyan}" />
                                    </Border>
                                </DockPanel>

                                <!-- Mini Cyber Keyboard & Lightbar Viewport -->
                                <Border Background="{DynamicResource KbChassisBg}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="KbGlowHalo" BlurRadius="18" ShadowDepth="0" Direction="0"
                                                          Color="#00FFFF" Opacity="0.55" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- mini keyboard key rows -->
                                        <StackPanel HorizontalAlignment="Center" Margin="0,2,0,6">
                                            <!-- row 1 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Border Width="16" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="16" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                            </StackPanel>
                                            <!-- row 2 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Border Width="14" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="10" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="18" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                            </StackPanel>
                                            <!-- row 3 spacebar -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="68" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                                <Border Width="20" Height="8" CornerRadius="2" Background="{DynamicResource KbKeyBg}" Margin="1,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- mini ambient bar at chassis front -->
                                        <Border x:Name="KbAmbientBar" Height="3" CornerRadius="1.5" Background="#00FFFF" Margin="6,2,6,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Switches & Controls Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <!-- 0: Ambient Light -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="机身前端氛围灯" Style="{StaticResource Row}" />
                                    <ToggleButton x:Name="AmbientSwitch" Grid.Row="0" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Checked="Ambient_Changed" Unchecked="Ambient_Changed" />

                                    <!-- 1: Keyboard Backlight -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="机械键盘背光" Style="{StaticResource Row}" />
                                    <ToggleButton x:Name="KbdSwitch" Grid.Row="1" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Checked="Kbd_Changed" Unchecked="Kbd_Changed" />

                                    <!-- 2: Brightness -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="键盘背光亮度" Style="{StaticResource Row}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider x:Name="KbdBright" Width="140" Style="{StaticResource LiquidSlider}" Minimum="0" Maximum="3" Value="3"
                                                SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="KbdBright_Changed" />
                                        <TextBlock x:Name="KbdBrightText" Text="10" Style="{StaticResource Value}"
                                                   Width="24" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 3: Hue Spectrum Slider & Readout (0x11) -->
                                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="纯色色相" Style="{StaticResource Row}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Continuous Rainbow Hue Bar -->
                                            <Border Height="8" CornerRadius="4" Margin="0,0,0,1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                                        <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                                        <GradientStop Color="#FF00FF00" Offset="0.33" />
                                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                                        <GradientStop Color="#FF0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Slider x:Name="HueSlider" Style="{StaticResource LiquidSlider}" Minimum="0" Maximum="359" Value="210"
                                                    SmallChange="1" LargeChange="15" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" ValueChanged="Hue_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="ColorText" Text="#00FFFF" Style="{StaticResource Value}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border x:Name="ColorSwatch" Width="26" Height="26" CornerRadius="7"
                                                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1.5"
                                                    Background="#00FFFF">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.3" />
                                                </Border.Effect>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4: Instant Esports Preset Palette Chips -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                HorizontalAlignment="Center" Margin="0,4,0,8">
                                        <TextBlock Text="预设调色" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#00FFFF" Tag="180" ToolTip="冰青蓝 Cyan" Click="PaletteChip_Click" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#9D4EDD" Tag="275" ToolTip="极客紫 Violet" Click="PaletteChip_Click" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#FF3366" Tag="345" ToolTip="烈焰红 Rose" Click="PaletteChip_Click" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#00E676" Tag="140" ToolTip="毒液绿 Emerald" Click="PaletteChip_Click" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#FFB300" Tag="38" ToolTip="琥珀金 Amber" Click="PaletteChip_Click" />
                                        <Button Style="{StaticResource PaletteChip}" Background="#FFFFFF" Tag="0" ToolTip="纯净白 White" Click="PaletteChip_Click" />
                                    </StackPanel>

                                    <!-- 5: Software Effects: Rainbow & Breathing -->
                                    <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="动态光效" Style="{StaticResource Row}" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="彩虹循环" Style="{StaticResource Row}" Margin="0,0,6,0" FontSize="11.5" />
                                            <ToggleButton x:Name="RainbowSwitch" Style="{StaticResource Switch}"
                                                          Checked="Rainbow_Changed" Unchecked="Rainbow_Changed" />
                                            <TextBlock Text="呼吸" Style="{StaticResource Row}" Margin="16,0,6,0" FontSize="11.5" />
                                            <ToggleButton x:Name="BreathSwitch" Style="{StaticResource Switch}"
                                                          Checked="Breath_Changed" Unchecked="Breath_Changed" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: GENERAL HARDWARE -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#1800E676" Margin="0,0,8,0">
                                            <TextBlock Text="🎮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="常规硬件与外设" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Switch 1: 独显直连 -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SubPanel}" Padding="8,8">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="独显直连" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="需重启生效" FontSize="9" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="DgpuSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                          Checked="Dgpu_Changed" Unchecked="Dgpu_Changed" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Switch 2: 触摸板锁定 -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SubPanel}" Padding="8,8">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="触摸板锁定" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="TPLock" FontSize="9" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="TpSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                          Checked="Tp_Changed" Unchecked="Tp_Changed" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Switch 3: OSD 事件提示 -->
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource SubPanel}" Padding="8,8">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="OSD 提示" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Caps/Num" FontSize="9" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="OsdSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                          Checked="Osd_Changed" Unchecked="Osd_Changed" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Switch 4: 开机静默自启 -->
                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SubPanel}" Padding="10,8">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="开机静默自启" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="计划任务 · 最高权限免 UAC · 延时 30s" FontSize="9" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="AutoStartSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                          Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Switch 5: 最小化到托盘 -->
                                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource SubPanel}" Padding="8,8">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="缩入托盘" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="关窗常驻" FontSize="9" Foreground="{DynamicResource SubtitleText}" />
                                            </StackPanel>
                                            <ToggleButton x:Name="TrayCloseSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                          Checked="TrayClose_Changed" Unchecked="TrayClose_Changed" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 4: EVENT LOG TERMINAL (COLLAPSIBLE) -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonDown="LogHeader_Click">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="8" Background="#1800F0FF" Margin="0,0,8,0">
                                            <TextBlock Text="📟" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="运行日志与实时诊断" />
                                        <TextBlock x:Name="LogSummaryText" Text="（点击展开 · 本地保留30天）" FontSize="11" Foreground="{DynamicResource SubtitleText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📁 打开日志目录" Style="{StaticResource Btn}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnOpenLogDir_Click" ToolTip="打开 %AppData%\TDPC\logs 日志文件夹" />
                                        <Button Content="清屏" Style="{StaticResource Btn}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnClearLog_Click" />
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BtnFace}" Margin="2,0,0,0">
                                            <TextBlock x:Name="LogExpandChevron" Text="▾" FontSize="12" Foreground="{DynamicResource LabelText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Console Viewport (Collapsed by default) -->
                                <Border x:Name="LogContainer" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource SegBg}" CornerRadius="10"
                                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                            Padding="10,8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                            <ItemsControl x:Name="EventList" />
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
